# TASI Financial Database - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONNECTION
# =============================================================================

# Option 1: Neon Serverless PostgreSQL (Recommended for production)
# Sign up at: https://neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/tasi_financials

# Option 2: Local PostgreSQL via Docker (docker-compose up -d)
# DATABASE_URL=postgresql://tasi:tasi_dev_123@localhost:5433/tasi_financials

# =============================================================================
# OPENROUTER (LLM for SQL generation)
# =============================================================================

# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# =============================================================================
# VANNA AI (optional - for Vanna cloud training)
# =============================================================================

# Get your API key from: https://vanna.ai
VANNA_API_KEY=your-vanna-api-key
VANNA_MODEL=tasi-financials

# =============================================================================
# OPENAI (optional - for embeddings / semantic search)
# =============================================================================

# Get your API key from: https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key
