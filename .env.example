# TASI Financial Database - Environment Configuration
# Copy this file to .env and fill in your values
#
# IMPORTANT: Never commit your .env file to version control!

# =============================================================================
# DATABASE CONNECTION (Required)
# =============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
#
# Option 1: Docker Compose (default for local development)
DATABASE_URL=postgresql://tasi:tasi_dev_123@localhost:5433/tasi_financials

# Option 2: Neon Serverless PostgreSQL (Recommended for production)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Option 3: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tasi_financials

# Database pool settings (optional)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_QUERY_TIMEOUT=30

# =============================================================================
# LLM SERVICE - OpenRouter (Required for natural language queries)
# =============================================================================

# Get your API key from: https://openrouter.ai/keys
# IMPORTANT: Do not use hardcoded keys in code!
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LLM model selection (optional - defaults shown)
LLM_MODEL=google/gemini-2.5-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000

# Alternative models you can use:
# LLM_MODEL=anthropic/claude-3-haiku
# LLM_MODEL=anthropic/claude-3-sonnet
# LLM_MODEL=openai/gpt-4-turbo

# =============================================================================
# VANNA AI (Optional - for Vanna hosted service)
# =============================================================================

# Get your API key from: https://vanna.ai
VANNA_API_KEY=your-vanna-api-key-here
VANNA_MODEL=tasi-financials

# =============================================================================
# OPENAI (Optional - for embeddings)
# =============================================================================

# Get your API key from: https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Debug mode (set to true for development)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional - leave empty for console only)
LOG_FILE=

# Maximum results to return
MAX_RESULTS=100

# Cache TTL in seconds
CACHE_TTL=300

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Enable SQL validation (highly recommended)
ENABLE_SQL_VALIDATION=true

# Maximum rows per query
MAX_QUERY_ROWS=1000

# =============================================================================
# STREAMLIT SETTINGS (Optional)
# =============================================================================

# Streamlit server settings (for deployment)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
